linters: linters_with_defaults(
    line_length_linter(88L),
    # The R files are sourced into a dashboard qmd, not a package, so this
    # linter has no scope to resolve names in: it flags everything attached by
    # setup.R, everything defined in sibling files, and every bare NSE column,
    # burying any real finding.
    object_usage_linter = NULL
  )
