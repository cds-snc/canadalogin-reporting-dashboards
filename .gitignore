# Secrets and connection config
.env
.env.local

# Quarto build artifacts
.quarto/
*_files/
/_book/
*.rmarkdown
**/*.quarto_ipynb

# Rendered deliverables (source-only repo; the all-in-one HTML is published to the
# sibling canadalogin-signal-check-publishing repo, never committed here)
*.html
/reports/
!_noindex.html

# Written by install.sh; machine-specific, so not shareable.
.venv/

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# OS
.DS_Store
._*
Icon?
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Written at render time beside the rendering dashboard's qmd, then pulled in by
# its include-after-body. Unanchored, so it matches at any depth.
analytics-tag.html

# Written at render time beside the qmd, then pulled in by include-before-body.
# Each dashboard composes the preflight banner and its context strip into it.
page-header.html

# Written beside the banner at render time; read by CI, never committed.
preflight-status.json
