# Copy this file to .env and fill in the values. .env is gitignored.
#
# Athena connection, read by R/connection.R via load_config(), which searches
# upward for .env. Same pattern as the metrics cookbook and Signal Check.
#
# The cl-data-analyst profile is a least-privilege role that chains through the
# cl-data-admin SSO session. Authenticate the source profile before rendering:
#   aws sso login --profile cl-data-admin

AWS_PROFILE=cl-data-analyst
AWS_REGION=ca-central-1
ATHENA_S3_STAGING_DIR=s3://your-athena-results-bucket/
